# Server
PORT=4000

# Signs the admin session cookie — a deployment-level secret, distinct from the admin password
# itself (which is set via onboarding/Settings and stored, hashed, in the JSON data file).
ADMIN_SESSION_SECRET=

# Everything else (Komodo URL/API key/secret, admin password, port denylist) is set on first run
# via the onboarding flow, and editable afterwards in Settings — see server/data/dashmodo.json.
