# Komodo instance dashmodo talks to (server-side only, never exposed to the browser)
KOMODO_URL=https://demo.komo.do
KOMODO_API_KEY=
KOMODO_API_SECRET=

# Server
PORT=4000
DASHMODO_DATA_FILE=./data/dashmodo.json

# Optional admin gate for the /settings page. Leave unset to disable auth
# (fine on a trusted homelab LAN).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Extra ports to treat as non-web when deriving stack links, comma-separated.
# Merged with the built-in deny-list (ssh, common db/queue ports, etc).
DASHMODO_PORT_DENYLIST=
